{
  "name": "@thisismissem/adonisjs-respond-with",
  "description": "A small plugin for Adonis.js to make responding with different content-types easier.",
  "version": "4.0.1",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.20.0",
  "type": "module",
  "files": [
    "build/",
    "build/stubs",
    "!build/bin",
    "!build/tests"
  ],
  "main": "build/index.js",
  "exports": {
    ".": "./build/index.js",
    "./types": "./build/src/types.js",
    "./provider": "./build/providers/respond_with.js"
  },
  "scripts": {
    "changeset": "changeset",
    "copy:templates": "copyfiles \"stubs/**/*.stub\" build",
    "typecheck": "tsc --noEmit",
    "lint": "pnpm run typecheck && eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:write": "prettier --write",
    "quick:test": "node --import=@poppinss/ts-exec --enable-source-maps bin/test.ts",
    "pretest": "pnpm run lint",
    "test": "c8 pnpm run quick:test",
    "types:check": "attw --pack . --profile esm-only --profile node16 --ignore-rules=cjs-resolves-to-esm",
    "precompile": "pnpm run lint",
    "compile": "tsdown && tsc --emitDeclarationOnly --declaration",
    "postcompile": "pnpm run copy:templates",
    "build": "pnpm run compile",
    "version-packages": "changeset version && pnpm run format:write CHANGELOG.md && git add package.json CHANGELOG.md",
    "release": "pnpm run build && changeset publish",
    "prepublishOnly": "pnpm run build"
  },
  "keywords": [
    "adonisjs",
    "content-negotiation",
    "conneg"
  ],
  "author": "Emelia Smith",
  "license": "MIT",
  "contributors": [
    {
      "name": "Emelia Smith",
      "url": "https://github.com/thisismissem"
    }
  ],
  "repository": {
    "url": "https://github.com/ThisIsMissEm/adonisjs-respond-with"
  },
  "dependencies": {
    "negotiator": "^1.0.0"
  },
  "devDependencies": {
    "@adonisjs/assembler": "^8.4.0",
    "@adonisjs/core": "^7.0.0",
    "@adonisjs/eslint-config": "^3.1.0",
    "@adonisjs/prettier-config": "^1.5.0",
    "@adonisjs/tsconfig": "^2.0.0",
    "@arethetypeswrong/cli": "^0.18.2",
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.0",
    "@japa/assert": "^4.2.0",
    "@japa/file-system": "^2.3.2",
    "@japa/runner": "^5.3.0",
    "@poppinss/ts-exec": "^1.4.4",
    "@types/mime-types": "^3.0.0",
    "@types/negotiator": "^0.6.4",
    "@types/node": "^25.6.0",
    "@types/sinon": "^22.0.0",
    "c8": "^11.0.0",
    "copyfiles": "^2.4.1",
    "eslint": "^10.2.1",
    "pino-pretty": "^13.1.2",
    "prettier": "^3.8.3",
    "sinon": "^22.1.0",
    "tsdown": "^0.21.10",
    "typescript": "^5.7.3",
    "yalc": "1.0.0-pre.53"
  },
  "peerDependencies": {
    "@adonisjs/assembler": "^8.4.0",
    "@adonisjs/core": "^7.0.0",
    "mime-types": "^3.0.1"
  },
  "peerDependenciesMeta": {
    "@adonisjs/assembler": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "tsdown": {
    "entry": [
      "./index.ts",
      "./configure.ts",
      "./providers/respond_with.ts",
      "./src/types.ts"
    ],
    "outDir": "./build",
    "clean": true,
    "format": "esm",
    "minify": "dce-only",
    "fixedExtension": false,
    "dts": false,
    "treeshake": false,
    "sourcemaps": false,
    "target": "esnext",
    "unbundle": true
  },
  "c8": {
    "reporter": [
      "text",
      "html"
    ],
    "exclude": [
      "tests/**"
    ]
  },
  "prettier": "@adonisjs/prettier-config"
}
